# PostgreSQL connection string
DB_URL=postgres://rag:rag@localhost:5432/ragdb

# Ollama base URL (default: local)
OLLAMA_URL=http://localhost:11434

# Ollama embedding model (produces 1024-dim vectors)
EMBED_MODEL=mxbai-embed-large

# Ollama generative model for RAG answers
GEN_MODEL=llama3

# PDF chunking for ingestion
CHUNK_SIZE=120
CHUNK_OVERLAP=24

# Number of top chunks to retrieve for search / RAG context
TOP_K=5

# HTTP server port
PORT=8080
