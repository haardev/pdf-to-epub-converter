# AI provider: ollama, azure-openai, azure-foundry
AI_PROVIDER=azure-foundry

# PostgreSQL connection string
DB_URL=postgres://rag:rag@localhost:5432/ragdb

# Ollama base URL (default: local)
OLLAMA_URL=http://localhost:11434

# Ollama embedding model (produces 1024-dim vectors)
EMBED_MODEL=text-embedding-3-large

# Ollama generative model for RAG answers
GEN_MODEL=gpt-4.1-mini

# Azure AI Foundry / Azure OpenAI settings
AZURE_AI_ENDPOINT=https://milen-ai-test.cognitiveservices.azure.com
AZURE_AI_API_KEY=<REDACTED>
AZURE_AI_API_VERSION=
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini

# Optional: set explicitly if you know the embedding size (e.g. 1024 or 3072)
EMBED_DIM=1536

# PDF chunking for ingestion
CHUNK_SIZE=90
CHUNK_OVERLAP=24

# Number of top chunks to retrieve for search / RAG context
TOP_K=5

# HTTP server port
PORT=8080
