# AI provider: ollama, azure-openai, azure-foundry
AI_PROVIDER=azure-foundry

# PostgreSQL connection string
DB_URL=postgres://rag:rag@localhost:5432/ragdb

# Ollama base URL (default: local)
OLLAMA_URL=http://localhost:11434

# Ollama embedding model (produces 1024-dim vectors)
EMBED_MODEL=text-embedding-3-large

# Ollama generative model for RAG answers
GEN_MODEL=gpt-4.1-mini

# Azure AI Foundry / Azure OpenAI settings
AZURE_AI_ENDPOINT=https://milen-ai-test.cognitiveservices.azure.com
AZURE_AI_API_KEY=<REDACTED>
AZURE_AI_API_VERSION=
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini

# Optional: set explicitly if you know the embedding size (e.g. 1024 or 3072)
EMBED_DIM=1536

# PDF chunking for ingestion (approximate token-sized word windows)
CHUNK_SIZE=400
CHUNK_OVERLAP=100

# Retrieval pipeline: top-20 recall, rerank, top-3 final context
RECALL_K=20
TOP_K=3

# Optional Azure AI Content Safety / guardrails integration
GUARDRAILS_ENABLED=false
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_API_VERSION=2024-09-01
CONTENT_SAFETY_BLOCKLISTS=
GUARDRAILS_INPUT_SEVERITY_THRESHOLD=4
GUARDRAILS_TOOL_CALL_SEVERITY_THRESHOLD=4
GUARDRAILS_OUTPUT_SEVERITY_THRESHOLD=4
GUARDRAILS_USER_PROMPT_SHIELD=true
GUARDRAILS_DOCUMENT_PROMPT_SHIELD=true
GUARDRAILS_OUTPUT_PROTECTED_MATERIAL=false

# HTTP server port
PORT=8080
